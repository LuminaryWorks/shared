{
  "name": "@luminaryworks/auth-react",
  "version": "0.3.1",
  "license": "Polyform-Noncommercial-1.0.0",
  "description": "LuminaryWorks unified OIDC SPA client (Logto / enterprise IdP)",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuminaryWorks/shared.git",
    "directory": "packages/auth-react"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "oidc-client-ts": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@luminary/tooling": "workspace:*",
    "@types/react": "^19.0.0",
    "esbuild-sass-plugin": "^3.3.1",
    "react": "^19.0.0",
    "sass": "^1.89.2",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
