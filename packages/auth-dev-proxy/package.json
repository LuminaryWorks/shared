{
  "name": "@luminaryworks/auth-dev-proxy",
  "version": "0.1.0",
  "license": "Polyform-Noncommercial-1.0.0",
  "description": "Same-origin /oidc + /api/experience dev proxy for LuminaryWorks SPAs (Rsbuild/Vite/Next)",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuminaryWorks/shared.git",
    "directory": "packages/auth-dev-proxy"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@luminary/tooling": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
