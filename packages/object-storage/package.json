{
  "name": "@luminaryworks/object-storage",
  "version": "0.1.0",
  "license": "Polyform-Noncommercial-1.0.0",
  "description": "LuminaryWorks MinIO-compatible object storage — ObjectStoragePort, scoped keys, trial purge, storage admission",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuminaryWorks/shared.git",
    "directory": "packages/object-storage"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "rstest",
    "prepublishOnly": "pnpm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@luminary/tooling": "workspace:*",
    "@rstest/core": "^0.4.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
