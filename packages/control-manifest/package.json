{
  "name": "@luminaryworks/control-manifest",
  "version": "0.1.0",
  "license": "Polyform-Noncommercial-1.0.0",
  "description": "LuminaryWorks Control Manifest — static deployment profile schema, parser, env overlay and preflight validation for federated product suites",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuminaryWorks/shared.git",
    "directory": "packages/control-manifest"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "schema/control-manifest.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-schema.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "schema:emit": "node scripts/emit-schema.mjs",
    "schema:check": "node scripts/emit-schema.mjs --check",
    "test": "rstest",
    "prepublishOnly": "pnpm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@luminary/tooling": "workspace:*",
    "@rstest/core": "^0.4.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema/control-manifest.schema.json": "./schema/control-manifest.schema.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
