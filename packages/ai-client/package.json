{
  "name": "@luminaryworks/ai-client",
  "version": "0.2.0",
  "license": "Polyform-Noncommercial-1.0.0",
  "description": "LuminaryWorks AI Platform client — catalog, list-models, complete, stream, embed, local BYOK adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuminaryWorks/shared.git",
    "directory": "packages/ai-client"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "require": "./dist/catalog.js",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
