{
  "name": "@luminaryworks/shared-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "LuminaryWorks shared libraries �?pnpm workspace for @luminaryworks/* packages",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm -r --if-present run check",
    "publish:packages": "pnpm --filter @luminaryworks/auth-core --filter @luminaryworks/auth-react --filter @luminaryworks/pal publish --no-git-checks"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
